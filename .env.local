# Google Analytics 4 (Admin > Data streams > Web > Measurement ID)
NEXT_PUBLIC_GA_ID=G-C56LWHD1RZ


# --- Ads ---
# AdSense publisher id. Optional: ca-pub-6211805066105040 is already built into lib/ads.ts; set this only to override it.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6211805066105040
# "review" (default) = AdSense application period, no Adsterra. "live" = after approval, AdSense units + Adsterra banner.
NEXT_PUBLIC_AD_MODE=review
# Create these units in AdSense after approval
NEXT_PUBLIC_AD_SLOT_POST_TOP=
NEXT_PUBLIC_AD_SLOT_POST_MID=
NEXT_PUBLIC_AD_SLOT_POST_BOTTOM=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
# Extra ads.txt lines from other networks (Adsterra dashboard), separate lines with \n
ADS_TXT_EXTRA=

# Ad unit slot ids (create after AdSense approval)


# Search Console / Bing verification (already supported)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ---- Career form delivery (see README) ----
# Leave empty while testing locally: applications are saved in ./applications.
# For production, get a key at resend.com and set these three:
RESEND_API_KEY=
APPLICATIONS_TO_EMAIL=
APPLICATIONS_FROM_EMAIL=
